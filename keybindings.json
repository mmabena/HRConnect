// Place your key bindings in this file to override the defaults
[
   // Move focus between editor groups like Neovim (Ctrl+h/j/k/l)
   {
        "key": "ctrl+h",
        "command": "workbench.action.focusLeftGroup",
        "when": "vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.focusRightGroup",
        "when": "vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.focusAboveGroup",
        "when": "vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.focusBelowGroup",
        "when": "vim.mode != 'Insert'"
    },

    
 // <leader>e = Space + e behavior
  // 1) Sidebar closed -> focus Files Explorer (opens + focuses)
  {
    "key": "space e",
    "command": "workbench.files.action.focusFilesExplorer",
    "when": "sideBarVisible == false && vim.mode == 'Normal'"
  },

  // 2) Sidebar open, but Explorer NOT focused -> focus Explorer
  {
    "key": "space e",
    "command": "workbench.files.action.focusFilesExplorer",
    "when": "sideBarVisible == true && explorerViewletFocus == false && vim.mode == 'Normal'"
  },

  // 3) Explorer open AND focused -> close the sidebar
  {
    "key": "space e",
    "command": "workbench.action.closeSidebar",
    "when": "explorerViewletFocus == true && vim.mode == 'Normal'"
  }
]
