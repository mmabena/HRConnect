{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (HRConnect.Api)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/HRConnect.Api/bin/Debug/net9.0/HRConnect.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/HRConnect.Api",
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }, 
  ]
}
